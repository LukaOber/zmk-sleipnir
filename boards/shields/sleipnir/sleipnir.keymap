#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include "sleipnir.dtsi"

&sk {
	release-after-ms = <TIMEOUT_STICKY_LEADER_KEY>;
};

&lt {
    tapping-term-ms = <TIMEOUT_LAYER_HOLD>;
    quick-tap-ms = <QUICK_TAP_TIME>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";
        MAKE_COMBOS(L, 0, 1, 2, 3, 4, 5, 6, 7);
        MAKE_COMBOS(R, 8, 9, 10, 11, 12, 13, 14, 15);
    };

    macros {
        qu_macro: qu_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp Q &kp U>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <LAYER_ID_NUM LAYER_ID_NAV>;
            then-layer = <LAYER_ID_FUN>;
        };
    };

    behaviors {
        layer_kp_qt_long: layer_kp_qt_long {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <TIMEOUT_LAYER_LONG_HOLD>;
            quick-tap-ms = <QUICK_TAP_TIME>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                &layer_kp_qt_long LAYER_ID_MWS SPACE &kp O
                &kp N                                &kp A
                &kp H                                &kp E
                &lt LAYER_ID_NAV BSPC                &lt LAYER_ID_NUM T

                &layer_kp_qt_long LAYER_ID_MWS SPACE &kp O
                &kp N                                &kp A
                &kp H                                &kp E
                &lt LAYER_ID_NAV BSPC                &lt LAYER_ID_NUM T
            >;
        };

        number {
            bindings = <
                &kp SPACE        &kp MINUS
                &kp N1           &kp N3
                &kp N2           &kp N4
                &kp BSPC         &mo LAYER_ID_NUM

                &kp SPACE        &kp MINUS
                &kp N1           &kp N3
                &kp N2           &kp N4
                &kp BSPC         &mo LAYER_ID_NUM
            >;
        };

        navigation {
            bindings = <
                &kp SPACE        &kp DEL
                &kp UP           &kp LEFT
                &kp DOWN         &kp RIGHT
                &mo LAYER_ID_NAV &none

                &kp SPACE        &kp DEL
                &kp UP           &kp LEFT
                &kp DOWN         &kp RIGHT
                &mo LAYER_ID_NAV &none
            >;
        };

        mouse {
            bindings = <
                &mo LAYER_ID_MWS &mkp MB3
                &mmv MOVE_UP     &mmv MOVE_LEFT
                &mmv MOVE_DOWN   &mmv MOVE_RIGHT
                &mkp MB2         &mkp MB1

                &mo LAYER_ID_MWS &mkp MB3
                &mmv MOVE_UP     &mmv MOVE_LEFT
                &mmv MOVE_DOWN   &mmv MOVE_RIGHT
                &mkp MB2         &mkp MB1
            >;
        };

        function {
            bindings = <
                &none            &kp PSCRN
                &kp N1           &kp N3
                &kp N2           &kp N4
                &none            &none

                &none            &kp PSCRN
                &kp N1           &kp N3
                &kp N2           &kp N4
                &none            &none
            >;
        };
    };
};
